              "body": "{\n  \"content\": [\n    {\n      \"contactId\": \"607f0558a7c898629dd47d7a\",\n      \"contactPhone\": \"1234567890\",\n      \"email\": \"john.doe@simpletext.org\",\n      \"firstName\": \"John\",\n      \"lastName\": \"Doe\",\n      \"birthday\": \"1985-05-15\",\n      \"lists\": [\n        {\n          \"name\": \"list name\"\n        }\n      ],\n      \"customFields\": {\n        \"zipcode\": \"12345\"\n      },\n      \"comment\": \"VIP client\",\n      \"subscriptionStatus\": \"OPT_IN\",\n      \"created\": \"2021-04-28T23:20:08.489Z\",\n      \"updated\": \"2021-05-28T20:20:08.489Z\",\n      \"updateSource\": \"IMPORTED_FROM_FILE\"\n    },\n    {\n      \"contactId\": \"607f0558a7c898629dd47d7a\",\n      \"contactPhone\": \"1234567890\",\n      \"email\": \"john.doe@simpletext.org\",\n      \"firstName\": \"John\",\n      \"lastName\": \"Doe\",\n      \"birthday\": \"1985-05-15\",\n      \"lists\": [\n        {\n          \"name\": \"list name\"\n        }\n      ],\n      \"customFields\": {\n        \"zipcode\": \"12345\"\n      },\n      \"comment\": \"VIP client\",\n      \"subscriptionStatus\": \"OPT_IN\",\n      \"created\": \"2021-04-28T23:20:08.489Z\",\n      \"updated\": \"2021-05-28T20:20:08.489Z\",\n      \"updateSource\": \"IMPORTED_FROM_FILE\"\n    }\n  ],\n  \"totalPages\": 3570,\n  \"totalElements\": 8256\n}",
