            "disableBodyPruning": true
          }
        },
        {
          "id": "dfdbed1f-757a-45de-a592-44c4e0ce7a09",
          "name": "Incoming/Outgoing Message Report",
          "request": {
            "name": "Incoming/Outgoing Message Report",
            "description": {
              "content": "Triggers when an outgoing message or incoming message is handled.\n\n**Example:** We create the incoming webhook for `8005551234` from contact phone `8001234567`:\n\n`{\"url\": \"http://www.yourdomain.com/receivesms.php\",\"triggers\": [\"INCOMING_MESSAGE\"],\"requestPerSecLimit\": 25,\"accountPhone\": \"8005551234\",\"contactPhone\": \"8001234567\"}`",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "",
                "report",
                "incoming"
              ],
              "host": [
                "yourdomain",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportId\": \"<string>\",\n  \"webhookId\": \"<string>\",\n  \"type\": \"<string>\",\n  \"values\": {\n    \"messageId\": \"<string>\",\n    \"subject\": \"<string>\",\n    \"mediaItems\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"text\": \"<string>\",\n    \"accountPhone\": \"<string>\",\n    \"contactPhone\": \"<string>\",\n    \"timestamp\": \"<dateTime>\",\n    \"category\": \"<string>\",\n    \"referenceType\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "cdab2559-ace1-4c27-83e7-e5b6c798826d",
              "name": "OK",
              "originalRequest": {
                "url": {
                  "protocol": "https",
                  "path": [
                    "",
                    "report",
                    "incoming"
                  ],
                  "host": [
                    "yourdomain",
                    "com"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "<API Key>"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reportId\": \"507f191e810c19729de860ea\",\n  \"webhookId\": \"507f191e810c19729de860ea\",\n  \"type\": \"UNSUBSCRIBE_REPORT\",\n  \"values\": {\n    \"messageId\": \"507f191e810c19729de860ea\",\n    \"subject\": \"Some message from SimpleTexting\",\n    \"mediaItems\": [\n      \"507f1f77bcf86cd799439011\",\n      \"507f1f77bcf86cd799439333\"\n    ],\n    \"text\": \"Hello! How are you?\",\n    \"accountPhone\": \"8005551234\",\n    \"contactPhone\": \"8001234567\",\n    \"timestamp\": \"2020-04-28T23:20:08.489Z\",\n    \"category\": \"SMS\",\n    \"referenceType\": \"API\"\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "",
              "cookie": [],
              "_postman_previewlanguage": "text"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        },
        {
          "id": "8502f08b-fc8d-48d8-933a-5c727d7198a9",
          "name": "Delivery/Non Delivered Message Report",
          "request": {
            "name": "Delivery/Non Delivered Message Report",
            "description": {
              "content": "Triggers when an outgoing message is reported as delivered or undelivered by the carrier.\n\n**Example:** We create the Delivery report for `8005551234` for the status of the outgoing messages to `8001234567`:\n\n`{\"url\": \"http://www.yourdomain.com/delivery.php\",\"triggers\": [\"DELIVERY_REPORT\"],\"requestPerSecLimit\": 25,\"accountPhone\": \"8005551234\",\"contactPhone\": \"8001234567\"}`\n\nYour custom domain `http://www.yourdomain.com/delivery.php` has been set as a delivery report webhook for this example. The SimpleTexting server will invoke the given call when a message with the messageId `507f191e810c19729de860ea` is delivered.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "",
                "report",
                "delivery"
              ],
              "host": [
                "yourdomain",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportId\": \"<string>\",\n  \"webhookId\": \"<string>\",\n  \"type\": \"<string>\",\n  \"values\": {\n    \"messageId\": \"<string>\",\n    \"category\": \"<string>\",\n    \"referenceType\": \"<string>\",\n    \"accountPhone\": \"<string>\",\n    \"contactPhone\": \"<string>\",\n    \"carrier\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
